---
/* eslint-disable astro/no-set-html-directive -- see the note in `[slug].astro`. */
import TutorialLayout from '@layouts/TutorialLayout.astro';
import referencesJson from '@data/tutorial/generated/references.json';
import versionsJson from '@data/tutorial/generated/versions.json';

interface Reference {
  id: string;
  category: string;
  categoryLabel: string;
  title: string;
  org: string;
  year: string;
  url: string;
  trust: string;
  tags: string;
  localPath: string;
  note: string;
}

interface VersionsPayload {
  html: string;
}

const references: Reference[] = referencesJson;
const groups = new Map<string, Reference[]>();
for (const entry of references) {
  const key = entry.categoryLabel === '' ? entry.category : entry.categoryLabel;
  const list = groups.get(key) ?? [];
  list.push(entry);
  groups.set(key, list);
}
const ordered = [...groups.entries()].sort(([a], [b]) => a.localeCompare(b));
const versions: VersionsPayload = versionsJson;
const versionsHtml = versions.html;

const TRUST_LABEL: Record<string, string> = {
  primary: '一手',
  vendor: '厂商',
  community: '社区',
  media: '媒体',
};
---

<TutorialLayout
  description="TileLang 教程引用的全部资料：上游地址、类型与本地快照说明。"
  path="/references/"
  title="资料与版本"
>
  <div class="mx-auto w-full max-w-4xl px-5 py-12 sm:px-8">
    <nav aria-label="面包屑" class="breadcrumbs text-sm opacity-70" data-reader-hide>
      <ul>
        <li>
          <a class="link link-hover" href="/">
            TileLang 教程
          </a>
        </li>
        <li>资料与版本</li>
      </ul>
    </nav>

    <header class="mt-6 border-b border-base-300 pb-8">
      <h1 class="text-3xl font-semibold tracking-tight">资料与版本</h1>
      <p class="mt-4 leading-relaxed opacity-75">
        教材正文里出现的每一处源码与资料引用，都指向这里列出的上游地址。本地快照只用于写作与核对，
        不上线；下面给出的是可以公开访问的原文链接。
      </p>
      <p class="mt-3 text-sm leading-relaxed opacity-70">
        例外的只有教程编者自己撰写的三篇综合笔记。它们是本项目的原创内容，因此随教程一起发布， 见{' '}
        <a class="link link-hover" href="/notes/">
          编者笔记
        </a>
        。
      </p>
    </header>

    <section class="prose mt-10 max-w-none" id="versions">
      <h2 class="scroll-mt-24">版本锁定</h2>
      <div set:html={versionsHtml} />
    </section>

    <section class="mt-12" id="sources">
      <h2 class="text-2xl font-semibold tracking-tight">引用清单（{references.length} 条）</h2>
      <p class="mt-2 text-sm opacity-70">
        按主题分组。每条给出上游地址与可信度标注；“一手”表示论文或源码本身，“厂商”表示厂商文档，
        “社区”表示第三方文章。
      </p>

      {ordered.map(([label, entries]) => (
        <div class="mt-8">
          <h3 class="border-b border-base-300 pb-2 text-lg font-semibold">
            {label} <span class="font-mono text-xs opacity-50">{entries.length}</span>
          </h3>
          <ul class="mt-4 space-y-4">
            {entries.map((entry) => (
              <li
                class="scroll-mt-24 rounded-xl border border-base-300 bg-base-100 px-4 py-3"
                id={`src-${entry.id}`}
              >
                <a
                  class="font-medium link link-hover"
                  href={entry.url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {entry.title}
                </a>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs opacity-60">
                  {entry.org !== '' && <span>{entry.org}</span>}
                  {entry.year !== '' && <span>· {entry.year}</span>}
                  <span>· {TRUST_LABEL[entry.trust] ?? entry.trust}</span>
                  <span class="font-mono">· {entry.id}</span>
                </div>
                {entry.note !== '' && (
                  <p class="mt-2 text-sm leading-relaxed opacity-70">{entry.note}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</TutorialLayout>
