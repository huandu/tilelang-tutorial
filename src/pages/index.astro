---
import ChapterCard from '@components/tutorial/ChapterCard.astro';
import ProgressOverview from '@components/tutorial/ProgressOverview.astro';
import TutorialLayout from '@layouts/TutorialLayout.astro';
import { TUTORIAL, chaptersOfPart, chapterPath } from '@lib/tutorial.ts';

const first = TUTORIAL.chapters[0];
const totalExercises = TUTORIAL.chapters.reduce((sum, c) => sum + c.exerciseCount, 0);
const totalQuiz = TUTORIAL.chapters.reduce((sum, c) => sum + c.quizCount, 0);
const totalFigures = TUTORIAL.chapters.reduce(
  (sum, c) => sum + c.figureCount + c.inlineFigureCount,
  0,
);
const totalMinutes = TUTORIAL.chapters.reduce((sum, c) => sum + c.readingMinutes, 0);

const readingPaths = [
  {
    label: '只想快点能写算子',
    route: '第 1–15 章 → 第 27–28 章',
    blurb: '先写语言与算子，再补性能和精度判断。',
  },
  {
    label: '要训练 / 推理大模型',
    route: '第 1–16 章 → 第 17–18 章',
    blurb: '从基础算子走到 MoE、MLA，以及 7B 模型的训练和推理。',
  },
  {
    label: '要改编译器与后端',
    route: '第 1–4 章 → 第 12 章 → 第 20–26 章 → 第 29–31 章',
    blurb: '读 IR、布局、流水和后端，最后写 pass 并提交上游。',
  },
  {
    label: '要在昇腾上做真实项目',
    route: '第 1–12 章 → 第 19、23、25 章 → 第五部分（第 32–39 章）',
    blurb: '从昇腾基础一路读到 DeepSeek 的 128 卡训练与推理链路。',
  },
];
---

<TutorialLayout
  description={`${TUTORIAL.chapters.length} 章的 TileLang 系统教程：从设计思想、算子实战，到编译期、NVIDIA 与昇腾后端，再到 DeepSeek 昇腾全栈开源组件的完整拆解。含可交互习题与章节自测。`}
  path="/"
  title="TileLang 系统教程"
>
  <div class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8">
    <!-- Hero -->
    <header class="relative overflow-hidden rounded-3xl border border-base-300 bg-base-100 p-8 sm:p-12">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
      ></div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-primary badge-outline font-mono">TileLang v0.1.15</span>
        <span class="badge badge-outline">DeepSeek 昇腾全栈</span>
      </div>
      <h1 class="mt-4 flex flex-wrap items-baseline gap-x-2 text-4xl font-semibold tracking-tight sm:text-5xl">
        <span>从零到一：</span>
        <span class="whitespace-nowrap">
          <span class="text-primary">TileLang</span> 系统教程
        </span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed opacity-80">
        面向会写 PyTorch、还没写过 kernel 的研发人员。从第一个算子写到 GEMM、Attention 与
        MoE，再进入编译器和 NVIDIA、昇腾两条后端。
      </p>

      <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl bg-base-200 px-4 py-3">
          <dt class="text-xs opacity-60">章节</dt>
          <dd class="font-mono text-2xl font-semibold">{TUTORIAL.chapters.length}</dd>
        </div>
        <div class="rounded-xl bg-base-200 px-4 py-3">
          <dt class="text-xs opacity-60">习题</dt>
          <dd class="font-mono text-2xl font-semibold">{totalExercises}</dd>
        </div>
        <div class="rounded-xl bg-base-200 px-4 py-3">
          <dt class="text-xs opacity-60">在线自测</dt>
          <dd class="font-mono text-2xl font-semibold">{totalQuiz}</dd>
        </div>
        <div class="rounded-xl bg-base-200 px-4 py-3">
          <dt class="text-xs opacity-60">图示</dt>
          <dd class="font-mono text-2xl font-semibold">{totalFigures}</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {first !== undefined && (
          <a class="btn btn-primary" href={chapterPath(first.slug)}>
            从第 1 章开始阅读
          </a>
        )}
        <a class="btn btn-outline" href="#outline">
          查看全部 {TUTORIAL.chapters.length} 章
        </a>
        <a class="btn btn-outline" href="#reading-paths">
          按目标选路线
        </a>
        <span class="text-sm opacity-60">
          通读约 {Math.round(totalMinutes / 60)} 小时（不含动手练习）
        </span>
      </div>
    </header>

    <!-- Progress -->
    <div class="mt-8">
      <ProgressOverview chapters={TUTORIAL.chapters} />
    </div>

    <!-- Reading paths -->
    <section class="mt-14 scroll-mt-24" id="reading-paths">
      <h2 class="text-2xl font-semibold tracking-tight">按目标阅读</h2>
      <p class="mt-2 text-sm opacity-70">四条路线都从第 1 章开始。也可以不看路线，直接顺序阅读。</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {readingPaths.map((item, index) => (
          <div class="card border border-base-300 bg-base-100">
            <div class="card-body">
              <span class="badge badge-ghost font-mono">路线 {index + 1}</span>
              <h3 class="card-title text-base">{item.label}</h3>
              <p class="font-mono text-xs leading-relaxed opacity-80">{item.route}</p>
              <p class="text-sm leading-relaxed opacity-70">{item.blurb}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Outline -->
    <section class="mt-14" id="outline">
      <h2 class="text-2xl font-semibold tracking-tight">全部章节</h2>
      <p class="mt-2 text-sm opacity-70">
        五部分递进：宏观、实用、深入、前沿，最后拆解一套真实开源栈。每章都含习题、自测和代码。
      </p>
      <div class="mt-8 space-y-12">
        {TUTORIAL.parts.map((part) => {
          const chapters = chaptersOfPart(part);
          return (
            <div>
              <div class="flex flex-wrap items-baseline gap-3 border-b border-base-300 pb-3">
                <span class="badge badge-primary badge-outline font-mono">{part.label}</span>
                <h3 class="text-xl font-semibold tracking-tight">{part.title}</h3>
                <span class="font-mono text-xs opacity-50">
                  第 {part.from}–{part.to} 章 · {chapters.length} 章
                </span>
              </div>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed opacity-70">{part.blurb}</p>
              <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {chapters.map((chapter) => (
                  <ChapterCard chapter={chapter} />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mt-14 rounded-2xl border border-base-300 bg-base-100 p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="text-lg font-semibold">版本与验证边界</h2>
          <p class="mt-2 text-sm leading-relaxed opacity-70">
            基于 TileLang <span class="font-mono">v0.1.15</span> 与 TileLang-Ascend
            <span class="font-mono">v0.1.2.000-release</span>。需要 GPU 或 NPU
            的示例均标为静态核对， 性能数字保留原始测量条件。
          </p>
        </div>
        <a class="btn btn-ghost btn-sm" href="/versions/">
          查看版本与边界
        </a>
      </div>
    </section>
  </div>
</TutorialLayout>
