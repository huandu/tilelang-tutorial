      "sub": "ProveFragmentContains",
      "shape": "diamond",
      "tone": "accent"
    },
    { "id": "ok1", "label": "是 → 升级到更宽的布局", "tone": "store" },
    { "id": "c2", "label": "否 → 两者都是 swizzle？", "shape": "diamond", "tone": "accent" },
    { "id": "ok2", "label": "是 → 合并：取更小粒度", "tone": "store" },
    { "id": "c3", "label": "否 → 在 kFree 阶段？", "shape": "diamond", "tone": "accent" },
    { "id": "ok3", "label": "是 → 逐根重推整条链路", "sub": "用代价模型择优", "tone": "store" },
    {
      "id": "fail",
      "label": "否 → LOG(FATAL) 硬失败",
      "sub": "Get different layout for ...",
      "tone": "warn"
    }
  ],
  "edges": [
    { "from": "x", "to": "c1" },
    { "from": "c1", "to": "ok1" },
    { "from": "c1", "to": "c2" },
