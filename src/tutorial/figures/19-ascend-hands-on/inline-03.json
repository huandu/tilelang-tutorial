      "tone": "warn"
    },
    {
      "id": "add",
      "label": "c_ub = a_ub + b_ub",
      "sub": "⑩ Vector 计算（T.tile.add）",
      "tone": "compute"
    },
    {
      "id": "bar2",
      "label": "barrier_all() ⑪",
