      "tone": "default"
    },
    {
      "id": "p",
      "label": "Python 方言层",
      "sub": "tilelang/ascend/language/* — copy 重拼成 tl.tileop.ascend_copy",
      "tone": "default"
    },
    {
      "id": "ir",
      "label": "TIR + SBlock",
      "sub": "tl.tileop.ascend_copy / tl.tileop.gemm",
      "tone": "default"
    },
    {
      "id": "sch",
      "label": "AscendPassPipelineBody",
      "sub": "AutoSchedule → AssignCore → InsertSync",
      "tone": "accent"
    },
    {
      "id": "cut",
      "label": "AscendLowerTileOp",
      "sub": "按 src/dst scope 选 DMAPath",
      "tone": "accent"
    },
    {
      "id": "op",
      "label": "ascend_copy_* 调用 + ascend_mad",
      "sub": "7 条搬运 + MX 两条",
      "tone": "default"
    },
    {
      "id": "cg",
      "label": "CodeGenTileLangAscend",
      "sub": "EmitGmToUbufCopy_ / EmitL1ToL0Copy_ / EmitMad_",
      "tone": "accent"
    },
    {
      "id": "cce",
      "label": "CCE 源文本",
      "sub": "asc_copy_gm2ub_align(...) / asc_mmad(...)",
      "tone": "store"
    },
    { "id": "bisheng", "label": "bisheng dav-3510 + ld.lld", "tone": "compute" }
  ],
  "edges": [
    { "from": "u", "to": "p" },
    { "from": "p", "to": "ir", "label": "重拼" },
    { "from": "ir", "to": "sch" },
    { "from": "sch", "to": "cut" },
    { "from": "cut", "to": "op", "label": "按 scope 选通路" },
    { "from": "op", "to": "cg", "label": "按名分派" },
    { "from": "cg", "to": "cce", "label": "发射" },
    { "from": "cce", "to": "bisheng" }
  ],
  "groups": [
    {
      "label": "编译期（TIR pass + codegen）",
      "nodes": ["sch", "cut", "op", "cg"],
      "tone": "default"
    }
