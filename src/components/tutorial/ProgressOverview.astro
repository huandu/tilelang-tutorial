---
import type { TutorialChapterMeta } from '@lib/tutorial.ts';

interface Props {
  chapters: TutorialChapterMeta[];
}

const { chapters } = Astro.props;
const total = chapters.length;
---

<section
  class="card border border-base-300 bg-base-100"
  data-progress-overview
  data-total={String(total)}
>
  <div class="card-body flex-row flex-wrap items-center gap-5">
    <div class="relative h-20 w-20 shrink-0">
      <svg aria-hidden="true" class="progress-ring h-20 w-20" viewBox="0 0 120 120">
        <circle class="progress-ring__track" cx="60" cy="60" fill="none" r="52" stroke-width="8" />
        <circle
          class="progress-ring__value"
          cx="60"
          cy="60"
          data-ring-value
          fill="none"
          r="52"
          stroke-linecap="round"
          stroke-width="8"
        />
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-lg font-semibold" data-progress-percent>
          0%
        </span>
      </div>
    </div>
    <div class="min-w-52 flex-1">
      <h2 class="card-title text-lg">学习进度</h2>
      <p class="mt-1 text-sm opacity-70">
        已读完{' '}
        <span class="font-mono text-base-content" data-progress-read>
          0
        </span>{' '}
        / {total} 章。 进度只保存在本机浏览器。
      </p>
    </div>
    <button class="btn btn-ghost btn-sm" data-reset-progress type="button">
      重置进度
    </button>
  </div>
</section>
