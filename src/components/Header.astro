---
import ThemeToggle from '@components/ThemeToggle.astro';
import { NAV_ITEMS, SITE } from '@lib/site.ts';

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<div class="drawer drawer-end sticky top-0 z-40">
  <input class="drawer-toggle" id="site-nav" type="checkbox" />

  <div class="drawer-content">
    <header class="border-b border-base-300 bg-base-200/90 backdrop-blur-md">
      <div class="navbar mx-auto h-16 w-full max-w-6xl gap-2 px-4 sm:px-6">
        <div class="navbar-start min-w-0 flex-1">
          <a class="btn btn-ghost gap-2 px-2 font-semibold tracking-tight" href="/">
            <span
              aria-hidden="true"
              class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary font-mono text-sm text-primary-content"
            >
              TL
            </span>
            <span class="truncate text-base">{SITE.title}</span>
          </a>
        </div>

        <nav aria-label="主导航" class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal gap-1 px-1">
            {NAV_ITEMS.map((item) => (
              <li>
                <a
                  aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                  class:list={[{ 'menu-active': !item.external && isActive(item.href) }]}
                  href={item.href}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  target={item.external ? '_blank' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="navbar-end gap-1.5">
          <a
            aria-label="GitHub 仓库"
            class="btn btn-ghost btn-circle hidden sm:inline-flex"
            href={SITE.repository}
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg aria-hidden="true" class="size-5" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
          </a>
          <ThemeToggle />
          {/* DaisyUI's drawer toggle is a label associated by `for`. */}
          {/* eslint-disable-next-line jsx-a11y/label-has-associated-control */}
          <label
            aria-label="打开导航菜单"
            class="btn btn-ghost btn-circle drawer-button lg:hidden"
            for="site-nav"
          >
            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.75"
              viewBox="0 0 24 24"
            >
              <path d="M4 7h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 17h16"></path>
            </svg>
          </label>
        </div>
      </div>
    </header>
  </div>

  <div class="drawer-side z-50">
    {/* eslint-disable-next-line jsx-a11y/label-has-associated-control */}
    <label aria-label="关闭导航菜单" class="drawer-overlay" for="site-nav"></label>
    <div class="flex min-h-full w-72 flex-col bg-base-100 text-base-content">
      <div class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
        <span class="font-semibold tracking-tight">{SITE.title}</span>
        {/* eslint-disable-next-line jsx-a11y/label-has-associated-control */}
        <label aria-label="关闭导航菜单" class="btn btn-ghost btn-circle btn-sm" for="site-nav">
          <svg
            aria-hidden="true"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.75"
            viewBox="0 0 24 24"
          >
            <path d="M6 6l12 12"></path>
            <path d="M18 6 6 18"></path>
          </svg>
        </label>
      </div>

      <nav aria-label="移动端主导航" class="flex-1 overflow-y-auto p-3">
        <ul class="menu w-full gap-1 text-base">
          {NAV_ITEMS.map((item) => (
            <li>
              <a
                aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                class:list={[{ 'menu-active': !item.external && isActive(item.href) }]}
                href={item.href}
                rel={item.external ? 'noopener noreferrer' : undefined}
                target={item.external ? '_blank' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={SITE.repository} rel="noopener noreferrer" target="_blank">
              GitHub 仓库
            </a>
          </li>
        </ul>
      </nav>

      <p class="border-t border-base-300 px-4 py-3 text-xs opacity-50">{SITE.domain}</p>
    </div>
  </div>
</div>

<script>
  const drawer = document.querySelector<HTMLInputElement>('#site-nav');

  drawer?.addEventListener('change', () => {
    if (drawer.checked) return;
    document.querySelector<HTMLElement>('[data-theme-toggle]')?.focus();
  });
</script>
